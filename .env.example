# Copy this file to `.env` and fill in your values. `.env` is gitignored.
#
# Two kinds of variables:
#   VITE_*  -> bundled into the browser (PUBLIC). Never put a secret here.
#   others  -> read only by the API server (/server). Safe for secrets.

# --- Client (PUBLIC, bundled) ---------------------------------------------

# Firebase web config. These are designed to be public (secured by Firestore
# rules), so they are fine to expose in the bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Show/hide AI features in the UI. Set to "false" to disable AI entirely.
VITE_AI_ENABLED=true

# Optional: where the API lives. Leave empty for same-origin '/api'.
# VITE_API_BASE_URL=https://api.your-domain.com

# --- Server only (SECRET, never prefix with VITE_) ------------------------

# AI provider keys. Set whichever you have; the server cascades in this order:
# OpenRouter -> Mistral -> Gemini -> Gemini backup.
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=

# Optional AI tuning
# OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
# OPENROUTER_REFERER=https://your-domain.com
# GEMINI_MODEL=gemini-2.5-flash            # change if Google retires the default
# GEMINI_MODEL_BACKUP=gemini-2.5-flash-lite

# API server config
PORT=8787
# SERVE_STATIC=true   # on the VPS, lets this process also serve the built dist/
# CORS_ORIGIN=        # only if the API is on a different origin than the app
