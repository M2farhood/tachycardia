{
  "name": "study-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "web": "npm run dev -w @study/web",
    "build:web": "npm run build -w @study/web",
    "lint": "npm run lint -w @study/web",
    "api": "npm run dev -w @study/server",
    "test": "node --test 'packages/core/test/**/*.test.js'",
    "check": "npm test && npm run build:web"
  }
}
